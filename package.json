{
  "name": "runup",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Unofficial spoiler-safe catch-up for Avengers: Doomsday — not affiliated with Marvel or Disney.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run catalog:public && npm run catalog:md && next build",
    "start": "next start",
    "catalog:public": "mkdir -p public/data && cp data/official-15.json public/data/official-15.json",
    "catalog:md": "node scripts/generate-official-15-md.mjs",
    "icons": "python3 scripts/generate-icons.py",
    "backgrounds": "python3 scripts/generate-void-background.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "gray-matter": "^4.0.3",
    "next": "^15.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.0.0"
  }
}
