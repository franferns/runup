# Posters are enabled by default (TMDB CDN URLs in data/official-15.json).
# Set to false to fall back to gradient placeholders.
NEXT_PUBLIC_ENABLE_POSTERS=true

# Supabase (Slice 7 — TV pairing). Leave blank to disable pairing UI sync.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical site URL for sitemap, Open Graph, and robots.txt
NEXT_PUBLIC_SITE_URL=https://before-doomsday.com
